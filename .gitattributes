# Normalize all text files to LF in the repo (CRLF only in working copy on Windows)
* text=auto eol=lf

# Explicitly LF for all project files
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.mjs  text eol=lf

# PowerShell scripts — CRLF preferred on Windows but LF in repo
*.ps1  text eol=lf

# Binary — no conversion
*.png  binary
*.jpg  binary
*.ico  binary
